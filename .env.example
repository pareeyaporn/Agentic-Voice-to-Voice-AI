# Copy this file to .env and fill in values as needed. .env itself is
# gitignored — never commit real secrets. Every value here has a code default
# too, so the project runs without a .env for the parts that don't need one
# (e.g. local embeddings need nothing at all).

# --- Embeddings (§1.3 Embedding & Indexing) ---
EMBEDDING_PROVIDER=sentence-transformers   # sentence-transformers | openai | voyage | cohere
EMBEDDING_MODEL=all-MiniLM-L6-v2           # model name for the chosen provider

# --- Vector store (§1.3) ---
# Two separate persistent directories, not one shared one: the demo slice is
# small enough to commit to git (~6.6MB); the full catalog is ~52MB, over
# GitHub's soft file-size limit, so it's gitignored — rebuild it yourself by
# re-running 1.3 build index.ipynb if you want full-catalog search.
CHROMA_PERSIST_DIR_HOME_KITCHEN=Code/1. Data Pipeline & Indexing/processed/chroma_db_home_kitchen
CHROMA_PERSIST_DIR_ALL=Code/1. Data Pipeline & Indexing/processed/chroma_db_all
CHROMA_COLLECTION=products_home_kitchen
CHROMA_COLLECTION_ALL=products_all

# --- LLM / orchestration (§2 Agentic Orchestration) ---
# Decided: OpenAI, using an existing account. LLM_MODEL stays blank in this
# template on purpose (OpenAI's lineup shifts, and this file is committed) —
# §2.2's Router has it pinned locally in the real, gitignored .env instead.
# Provider is swappable via these vars (model-agnostic requirement); langgraph
# uses langchain-openai to call whichever provider is configured.
LLM_PROVIDER=openai                        # openai | anthropic | google | bedrock | local
LLM_MODEL=                                 # pin your own model string in your local .env
OPENAI_API_KEY=                            # only if LLM_PROVIDER=openai
ANTHROPIC_API_KEY=                         # only if LLM_PROVIDER=anthropic
GOOGLE_API_KEY=                            # only if LLM_PROVIDER=google

# --- Web search tool (§3.3, live in Code/3. MCP Server & Tools/web_search_tool.py) ---
# Decided: Tavily — purpose-built for LLM/agent consumption (clean, structured,
# relevance-ranked results, no scraping/parsing needed), free tier is 1,000
# credits/month with no credit card, official MCP server exists as a reference
# (github.com/tavily-ai/tavily-mcp) though this project wraps it as one tool
# inside our own single MCP server rather than running it standalone.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Speech: ASR (§4.1, in Code/4. Speech (ASR + TTS)/asr.py) ---
# Decided: faster-whisper — local/free, no API key or billing, same
# cost-conscious reasoning as §1.3's local sentence-transformers embeddings.
ASR_PROVIDER=faster-whisper                # faster-whisper (only implemented option)
ASR_MODEL_SIZE=base                        # tiny | base | small | medium | large-v3 -- speed/accuracy trade-off
ASR_DEVICE=cpu                             # cpu | cuda
ASR_COMPUTE_TYPE=int8                      # int8 is fastest on CPU; float16 needs a GPU

# --- Speech: TTS (§4.2, in Code/4. Speech (ASR + TTS)/tts.py) ---
# Decided: OpenAI TTS — reuses OPENAI_API_KEY above, cheap (~$15/1M chars,
# a small fraction of a cent per ~15s answer). Real spend, but trivial at
# demo volume (confirmed with the user, weighed against a free local option
# and ElevenLabs).
TTS_PROVIDER=openai                        # openai (only implemented option; swappable later per §4.2's brief)
TTS_MODEL=tts-1                            # tts-1 (fast) | tts-1-hd (higher quality, slower)
TTS_VOICE=alloy                            # alloy | echo | fable | onyx | nova | shimmer
