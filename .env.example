# Copy this file to .env and fill in values as needed. .env itself is
# gitignored — never commit real secrets. Every value here has a code default
# too, so the project runs without a .env for the parts that don't need one
# (e.g. local embeddings need nothing at all).

# --- Embeddings (§1.3 Embedding & Indexing) ---
EMBEDDING_PROVIDER=sentence-transformers   # sentence-transformers | openai | voyage | cohere
EMBEDDING_MODEL=all-MiniLM-L6-v2           # model name for the chosen provider

# --- Vector store (§1.3) ---
# One persistent directory, two collections: the demo slice and the full catalog.
CHROMA_PERSIST_DIR=Code/data/processed/chroma_db
CHROMA_COLLECTION=products_home_kitchen
CHROMA_COLLECTION_ALL=products_all

# --- LLM / orchestration (§2 Agentic Orchestration — not built yet) ---
LLM_PROVIDER=                              # openai | anthropic | google | bedrock | local
LLM_MODEL=                                 # e.g. gpt-4o-mini, claude-sonnet-5, gemini-2.5-flash
OPENAI_API_KEY=                            # only if LLM_PROVIDER=openai
ANTHROPIC_API_KEY=                         # only if LLM_PROVIDER=anthropic
GOOGLE_API_KEY=                            # only if LLM_PROVIDER=google

# --- Web search tool (§3 Tool & MCP Layer — not built yet) ---
WEB_SEARCH_PROVIDER=                       # brave | serper | bing
WEB_SEARCH_API_KEY=
